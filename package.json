{
  "name": "skillup-platform",
  "version": "0.0.0",
  "private": true,
  "description": "Pakistan-first mobile-first gamified learning platform",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "24.18.x",
    "pnpm": "11.17.x"
  },
  "scripts": {
    "shared:build": "pnpm --filter @skillup/contracts --filter @skillup/content-schema --filter @skillup/gameplay-engine --filter @skillup/discoverability --filter @skillup/analytics --filter @skillup/ui --filter @skillup/database build",
    "dev": "pnpm shared:build && pnpm --parallel --filter @skillup/api --filter @skillup/web dev",
    "dev:web": "pnpm shared:build && pnpm --filter @skillup/web dev",
    "dev:api": "pnpm shared:build && pnpm --filter @skillup/api dev",
    "foundation:check": "node tools/validate-foundation.mjs && node tools/validate-boundaries.mjs",
    "deployment:check": "node tools/validate-deployment.mjs",
    "production:check": "node tools/validate-production-readiness.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "pnpm shared:build && pnpm -r --if-present typecheck",
    "test": "pnpm shared:build && pnpm -r --if-present test && node tools/run-python-tests.mjs",
    "build": "pnpm -r --if-present build",
    "check": "pnpm foundation:check && pnpm deployment:check && pnpm production:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "container:build": "docker build --file infra/docker/api.Dockerfile --tag skillup-api:local . && docker build --file infra/docker/web.Dockerfile --tag skillup-web:local .",
    "clean": "node tools/clean.mjs",
    "db:generate": "pnpm --filter @skillup/database db:generate",
    "db:wait": "pnpm --filter @skillup/database db:wait",
    "db:migrate": "pnpm --filter @skillup/database db:migrate",
    "db:seed": "pnpm --filter @skillup/database db:seed",
    "db:smoke": "pnpm --filter @skillup/database db:smoke",
    "smoke:api": "node tools/smoke-api.mjs",
    "smoke:live": "node tools/smoke-live.mjs",
    "release:evidence": "node tools/write-release-evidence.mjs",
    "local:setup": "pnpm infra:up && pnpm db:wait && pnpm db:migrate && pnpm db:seed && pnpm db:smoke",
    "infra:up": "docker compose -f infra/compose.yaml up -d",
    "infra:down": "docker compose -f infra/compose.yaml down",
    "infra:reset": "docker compose -f infra/compose.yaml down -v"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
