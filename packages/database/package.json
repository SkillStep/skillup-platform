{
  "name": "@skillup/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "drizzle"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:wait": "node --env-file-if-exists=../../.env --import tsx src/cli/wait.ts",
    "db:migrate": "node --env-file-if-exists=../../.env --import tsx src/cli/migrate.ts",
    "db:seed": "node --env-file-if-exists=../../.env --import tsx src/cli/seed.ts",
    "db:smoke": "node --env-file-if-exists=../../.env --import tsx src/cli/smoke.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "24.12.1",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
