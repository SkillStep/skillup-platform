{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "/infra/docker/ai-worker.Dockerfile",
    "watchPatterns": [
      "/services/ai-worker/**",
      "/infra/docker/ai-worker.Dockerfile",
      "/infra/railway/ai-worker.railway.json",
      "/.python-version"
    ]
  },
  "deploy": {
    "startCommand": "python -m skillup_ai_worker.worker",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "overlapSeconds": 0,
    "drainingSeconds": 30
  }
}
