{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "/infra/docker/api.Dockerfile",
    "watchPatterns": [
      "/apps/api/**",
      "/packages/**",
      "/infra/docker/api.Dockerfile",
      "/package.json",
      "/pnpm-lock.yaml",
      "/pnpm-workspace.yaml",
      "/tsconfig.base.json"
    ]
  },
  "deploy": {
    "preDeployCommand": [
      "node node_modules/@skillup/database/dist/cli/migrate.js"
    ],
    "healthcheckPath": "/v1/ready",
    "healthcheckTimeout": 180,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "overlapSeconds": 20,
    "drainingSeconds": 30
  }
}
