# Local environment only. Copy to .env and keep the copy untracked.

APP_ENV=local
PUBLIC_APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:3001
PUBLIC_SUPPORT_EMAIL=admin@codistan.org
LOG_LEVEL=info

# PostgreSQL local development
POSTGRES_DB=skillup
POSTGRES_USER=skillup_local
POSTGRES_PASSWORD=replace-with-local-only-password
DATABASE_URL=postgresql://skillup_local:replace-with-local-only-password@localhost:5432/skillup
MAINTENANCE_INTERVAL_SECONDS=60

# Passwordless browser authentication
SESSION_COOKIE_NAME=skillup_session
SESSION_SECRET=replace-with-at-least-32-random-bytes
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=168
AUTH_CHALLENGE_MINUTES=10

# Email delivery remains disabled by default. Staging/production may enable reviewed SMTP delivery.
EMAIL_PROVIDER=disabled
EMAIL_FROM=no-reply@example.invalid
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=

# S3-compatible storage is disabled in the first local bootstrap.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# Unreleased product capabilities stay fail-closed until their own reviewed launch gates pass.
FEATURE_AI_GENERATION_ENABLED=false
FEATURE_PREMIUM_ENABLED=false
FEATURE_JAZZCASH_ENABLED=false

# Provider-agnostic AI gateway. Live execution remains disabled until provider terms, privacy
# approval, credentials and golden-task evaluation are approved. DeepSeek V4 Flash is the
# lowest-cost current launch candidate; keep the initial concurrency and budgets deliberately low.
AI_PROVIDER=disabled
AI_FALLBACK_PROVIDER=disabled
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
GROQ_API_KEY=
GROQ_API_BASE_URL=https://api.groq.com/openai
GROQ_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_API_BASE_URL=https://openrouter.ai/api
OPENROUTER_MODEL=
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=SkillUp
AI_MAX_COST_USD_PER_JOB=0.005
AI_DAILY_BUDGET_USD=1
AI_MONTHLY_BUDGET_USD=20
AI_MAX_CONCURRENCY=1
AI_MAX_RETRIES=2
AI_REQUEST_TIMEOUT_SECONDS=30
AI_CIRCUIT_FAILURE_THRESHOLD=5
AI_CIRCUIT_RESET_SECONDS=60
AI_CACHE_TTL_SECONDS=86400
AI_BUDGET_DB_PATH=/var/lib/skillup-ai/ai-gateway.sqlite3
AI_JOB_API_URL=http://localhost:3001
AI_JOB_API_TIMEOUT_SECONDS=15
AI_WORKER_SHARED_SECRET=
AI_WORKER_ID=
AI_WORKER_POLL_SECONDS=1
AI_WORKER_LEASE_SECONDS=120
AI_WORKER_MAX_ATTEMPTS=3
AI_EVALUATION_LIVE=false

# JazzCash remains disabled until merchant mode, credentials, callback rules and sandbox evidence
# are reviewed. Never commit real values. Sandbox and production secrets must be isolated.
# Payment, status-inquiry and refund URLs must come from the current merchant integration pack.
JAZZCASH_MODE=disabled
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_PAYMENT_URL=
JAZZCASH_RETURN_URL=http://localhost:3000/en/account/payment-return
JAZZCASH_STATUS_URL=
JAZZCASH_REFUND_URL=
JAZZCASH_REFUND_ENVELOPE=refund-request
JAZZCASH_CPS_TIMEOUT_SECONDS=15
JAZZCASH_VERSION=1.1
JAZZCASH_TXN_TYPE=MWALLET
JAZZCASH_BANK_ID=TBANK
JAZZCASH_PRODUCT_ID=RETL
JAZZCASH_CHECKOUT_MINUTES=15

# Observability and immutable deployment identity. Deployment automation must replace the local
# placeholders in staging/production. These values are safe metadata, never credentials.
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
RELEASE_SHA=local
RELEASE_PIPELINE_ID=local
RELEASE_ARTIFACT_REF=local
RELEASE_IMAGE_DIGEST=local
ROLLBACK_ARTIFACT_REF=unknown
