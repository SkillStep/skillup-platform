# Local environment only. Copy to .env and keep the copy untracked.

APP_ENV=local
PUBLIC_APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:3001

# PostgreSQL local development
POSTGRES_DB=skillup
POSTGRES_USER=skillup_local
POSTGRES_PASSWORD=replace-with-local-only-password
DATABASE_URL=postgresql://skillup_local:replace-with-local-only-password@localhost:5432/skillup

# Passwordless browser authentication
SESSION_COOKIE_NAME=skillup_session
SESSION_SECRET=replace-with-at-least-32-random-bytes
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=168
AUTH_CHALLENGE_MINUTES=10

# Email delivery remains disabled by default. Staging/production may enable reviewed SMTP delivery.
EMAIL_PROVIDER=disabled
EMAIL_FROM=no-reply@example.invalid
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=

# S3-compatible storage is disabled in the first local bootstrap.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# AI providers are disabled by default.
AI_PROVIDER=disabled
DEEPSEEK_API_KEY=
AI_MAX_COST_USD_PER_JOB=0.02

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
RELEASE_SHA=local

# Payment provider remains disabled until the approved JazzCash sandbox contract exists.
JAZZCASH_MODE=disabled
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
